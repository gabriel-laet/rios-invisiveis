# Optional: URL template for georeferenced SARA Brasil 1930 raster tiles,
# e.g. https://cdn.example.com/sara1930/{z}/{x}/{y}.png. Without it the
# "Mapa SARA 1930" toggle is hidden.
NEXT_PUBLIC_SARA_TILES=

# Optional: serve the app under a sub-path, e.g. /p/rios-invisiveis
# (for gabriel-laet.com/p/rios-invisiveis). Leave empty to serve at the root.
NEXT_PUBLIC_BASE_PATH=
